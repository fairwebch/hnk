# Sadržaj dolazi sa self-hosted PHP CMS-a (hostpoint-cms/); bez override-a
# sve lib/*Api.ts rute idu na https://api-staging.kroatien-schwyz.ch.
# Override samo za lokalno testiranje PHP-a (php -S 127.0.0.1:8098 -t hostpoint-cms/public):
# SPONSORS_API_BASE_URL=http://127.0.0.1:8098
# (isto: CLAN_UPRAVE_, STRANICA_, MOMCADI_, GALERIJE_, NOVOSTI_, DOGADJAJI_, SAJT_, KLUB_, PRIJAVA_ _API_BASE_URL)

# E-mail (kontakt + postani-clan rute; prijave na događaje šalje PHP)
RESEND_API_KEY=
CONTACT_TO=info@kroatien-schwyz.ch

# Newsletter (Brevo, double opt-in)
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
